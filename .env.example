# REVERSAL TERMINAL — environment configuration
# Copy to `.env` (same folder) and edit. `.env` is git-ignored: never commit it.
# NOTHING here is required for research + paper trading: every data source is free and public.

# --- Core -------------------------------------------------------------------
# Default database: backend/data/reversal_terminal.db
# DATABASE_URL=sqlite:///C:/path/to/reversal_terminal.db   (absolute path; leave commented to use the default)
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Providers ----------------------------------------------------------------
MARKET_DATA_PROVIDER=polymarket
# Underlying price reference per asset: chainlink (Polymarket RTDS — same oracle
# family that settles the markets, recommended) | binance
BTC_PRICE_PROVIDER=chainlink
ETH_PRICE_PROVIDER=chainlink
SOL_PRICE_PROVIDER=chainlink
XRP_PRICE_PROVIDER=chainlink
DOGE_PRICE_PROVIDER=chainlink
HYPE_PRICE_PROVIDER=chainlink
BNB_PRICE_PROVIDER=chainlink

# Placeholders for a future paid data vendor. Unused today — leave blank.
OPTIONAL_DATA_API_KEY=
OPTIONAL_DATA_API_SECRET=

# --- Collector ------------------------------------------------------------------
ENABLED_ASSETS=BTC,ETH,SOL,XRP,DOGE,HYPE,BNB
OBSERVATION_INTERVAL_MS=1000
RESOLUTION_POLL_SECONDS=15
DISCOVERY_POLL_SECONDS=20

# --- Paper execution realism ------------------------------------------------------
# Simulated network + matching latency before an order touches the book
PAPER_LATENCY_MS=400
PAPER_MIN_ORDER_SHARES=5
PAPER_MIN_MARKETABLE_NOTIONAL=1.0

# --- Remote access (website + iPhone app) ------------------------------------------
# Login password. REQUIRED when the server is reachable from the internet.
APP_PASSWORD=
# Random string used to sign login sessions (generate: python -c "import secrets;print(secrets.token_hex(32))")
SESSION_SECRET=

# --- Live trading (REAL MONEY) ------------------------------------------------------------
# Off by default. Live orders need ALL of: LIVE_TRADING_ENABLED=true, the keys below, a live
# account with a running bot session (risk budget + stop loss), and "Arm" on the Live page.
USER_COUNTRY=NL
LIVE_TRADING_ENABLED=false
# Easiest: add keys in the app (Live trading -> API keys). Or set them here (server-side ONLY):
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
# optional: Relayer key (Settings -> API Keys) OR Builder trio (Settings -> Builders, what Polybot used)
POLYMARKET_RELAYER_KEY=
POLYMARKET_RELAYER_ADDRESS=
POLYMARKET_BUILDER_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
# Shared secret between the backend and the executor process (random string)
EXECUTOR_TOKEN=
EXECUTOR_URL=http://127.0.0.1:8787
# Hard safety caps (enforced by both the backend and the executor)
LIVE_MAX_ORDER_USD=5
LIVE_MAX_SESSION_BUDGET_USD=100
# Optional custom Polygon RPC for balance reads / redemptions
POLYGON_RPC=

# --- Backups -----------------------------------------------------------------------
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=8

# --- Frontend (put in frontend/.env.local if you change ports/hosts) ----------------
# BACKEND_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/live
